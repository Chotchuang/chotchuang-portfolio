{
  "name": "chotchuang-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Decision-focused portfolio for Chotchuang.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:pages",
    "build:pages": "CF_PAGES=1 next build",
    "check:pages": "npm run build:pages && node scripts/verify-pages-build.mjs",
    "preview:pages": "npx serve out",
    "start": "next start",
    "test": "npm run build:pages && node --test tests/rendered-html.test.mjs",
    "check:public": "node scripts/verify-public-hygiene.mjs",
    "check:release": "npm run check:public && npm run lint && npm test && node scripts/verify-pages-build.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check:format": "git diff --check"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
